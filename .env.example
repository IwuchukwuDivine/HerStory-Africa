# No environment variables are required for local development of the site itself.
# This file exists so `cp .env.example .env` works as documented in the README.

# ── Build scripts (node --env-file=.env scripts/...) ──────────────────
# ANTHROPIC_API_KEY=   # npm run ai:generate, ai:embed, ai:relationships
# VOYAGE_API_KEY=      # npm run ai:embed (Voyage AI embeddings, voyageai.com)

# ── Runtime (server API routes; set these in Vercel for production) ───
# NUXT_BUTTONDOWN_API_KEY=  # /api/subscribe
# NUXT_GITHUB_TOKEN=        # /api/suggest
# NUXT_ANTHROPIC_API_KEY=   # /api/ask (HerStory AI Q&A)
# NUXT_VOYAGE_API_KEY=      # /api/ask (query embeddings)
