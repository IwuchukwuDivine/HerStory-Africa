# Copy this file to .env and fill in real values:  cp .env.example .env
# Everything prefixed NUXT_ is read by the running app (server routes) via
# runtimeConfig. Set the same keys in the Vercel project settings for production.
# Never commit the real .env — only this template.

# ── Newsletter (public subscribe form) ──────────────────────────────
# Buttondown API key. Buttondown → Settings → Programming → API.
NUXT_BUTTONDOWN_API_KEY=

# ── GitHub (suggestions: create + list + close issues) ──────────────
# Fine-grained Personal Access Token with "Issues: Read and write" on the
# IwuchukwuDivine/HerStory-Africa repo. Where to generate it:
#   github.com → your avatar → Settings → Developer settings
#   → Personal access tokens → Fine-grained tokens → Generate new token
#   → Repository access: Only select repositories → HerStory-Africa
#   → Repository permissions → Issues: Read and write
# (Classic tokens also work with the "repo" scope.)
NUXT_GITHUB_TOKEN=

# ── Admin dashboard (/admin) ────────────────────────────────────────
# The single passphrase you type to log in. Pick something strong.
NUXT_ADMIN_PASSPHRASE=

# Secret used to encrypt/seal the admin session cookie. Must be >= 32 chars.
# Generate one with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# ── Email (acceptance notifications via Resend) ─────────────────────
# Resend API key. resend.com → API Keys → Create API Key (Sending access).
# The sending domain (herstoryafrica.com.ng) must be verified in Resend.
NUXT_RESEND_API_KEY=

# ── Analytics (admin dashboard GA4 charts) ──────────────────────────
# Numeric GA4 Property ID (NOT the "G-XXXX" measurement id).
#   GA4 Admin → Property Settings → Property ID (e.g. 123456789)
NUXT_GA4_PROPERTY_ID=

# Google service-account JSON, base64-encoded (recommended — no quoting/newline
# issues in .env or Vercel):  base64 -i key.json | tr -d '\n' | pbcopy
# (Raw one-line JSON also works if it starts with "{".)
# Setup: Google Cloud Console → enable "Google Analytics Data API" →
#   create a service account → create a JSON key → in GA4 Admin →
#   Property Access Management, add the service-account email as Viewer.
NUXT_GA4_CREDENTIALS=

# ── Standalone maintenance scripts (npm run newsletter:draft / ai:generate) ──
# These are used only by files in scripts/, not the running app.
BUTTONDOWN_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
